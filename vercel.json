{
  "buildCommand": "cd frontend && npm ci && npm run build",
  "outputDirectory": "frontend/dist",
  "framework": "vite",
  "functions": {
    "api/og.js": {
      "includeFiles": "frontend/dist/index.html"
    }
  },
  "routes": [
    { "src": "/api/og", "dest": "/api/og" },
    { "src": "/api/(platform|salon|whatsapp)/(.*)", "dest": "https://groomit-backend.onrender.com/api/$1/$2" },
    { "src": "/actuator/(.*)", "dest": "https://groomit-backend.onrender.com/actuator/$1" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*\\.[a-zA-Z0-9]+)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/og" }
  ]
}
