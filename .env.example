# Local infrastructure (copy to .env; never commit real credentials)
POSTGRES_DB=groomit
POSTGRES_USER=groomit
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
DATABASE_URL=jdbc:postgresql://localhost:5432/groomit
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

# Backend runtime. Use dev locally; staging/prod are selected by the task runtime.
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
BASE_DOMAIN=localhost
PLATFORM_HOSTS=localhost,www.localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGIN_PATTERNS=http://*.localhost:5173

# Generate a unique 64+ byte value. Production value belongs in Secrets Manager.
JWT_SECRET=raw:replace-with-at-least-64-random-bytes
JWT_ISSUER=groomit-local
JWT_TTL=8h
AUTH_COOKIE_DOMAIN=.lvh.me
AUTH_COOKIE_SECURE=false

# One-time local bootstrap only. Disable after first successful startup.
PLATFORM_ADMIN_BOOTSTRAP_ENABLED=false
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# Email: logging for local use; resend requires a verified sender and secret API key.
EMAIL_PROVIDER=logging
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_OUTBOX_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=6
EMAIL_CLAIM_DURATION=2m
EMAIL_BASE_RETRY_DELAY=30s
EMAIL_MAX_RETRY_DELAY=30m
EMAIL_SCHEDULING_ENABLED=true
EMAIL_REMINDER_SCAN_DELAY_MS=60000
EMAIL_PROCESS_DELAY_MS=5000

# Frontend build-time public settings only (never put secrets in VITE_*).
VITE_API_BASE_URL=
VITE_API_PROTOCOL=http
VITE_API_PORT=8080
VITE_BASE_DOMAIN=lvh.me
VITE_BASE_PROTOCOL=http
VITE_BASE_PORT=5173

# Distributed authentication rate limiting and OTP verification.
# Set a separate 64+ byte HMAC secret in production; blank derives from JWT_SECRET.
APP_AUTH_SECURITY_HMAC_SECRET=
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW=5m
AUTH_RATE_LIMIT_REDIS_ENABLED=true
OTP_CODE_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_CHALLENGE_TTL=10m
OTP_PROOF_TTL=5m
OTP_RESEND_DELAY=60s
OTP_ALLOW_CODE_LOGGING=true
OTP_REQUIRE_SIGNUP_VERIFICATION=true

# Salon media. Local development is disabled; production uses the S3 values from Terraform.
MEDIA_STORAGE_PROVIDER=disabled
MEDIA_OBJECT_PREFIX=salons
MEDIA_CDN_BASE_URL=
MEDIA_PRESIGN_TTL=5m
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=us-east-1

# Web Push is provider-neutral and disabled until a production PushGateway is configured.
PUSH_ENABLED=false
PUSH_PROVIDER=disabled
PUSH_OUTBOX_BATCH_SIZE=25
PUSH_MAX_ATTEMPTS=8
PUSH_CLAIM_DURATION=2m
PUSH_BASE_RETRY_DELAY=30s
PUSH_MAX_RETRY_DELAY=30m
PUSH_PROCESS_DELAY_MS=5000
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=