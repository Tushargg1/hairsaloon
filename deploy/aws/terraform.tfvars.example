# Placeholders only. Do not put secret values in this file.
aws_region = "<deployment-region>"

project_name    = "groomit"
environment     = "prod"
domain_name     = "groomit.in"
route53_zone_id = "<existing-public-hosted-zone-id>"
vpc_id           = "<existing-vpc-id>"
public_subnet_ids = [
  "<public-subnet-id-a>",
  "<public-subnet-id-b>",
]
private_subnet_ids = [
  "<private-subnet-id-a>",
  "<private-subnet-id-b>",
]

container_image_tag  = "<immutable-release-tag>"
frontend_bucket_name = "<globally-unique-private-frontend-bucket-name>"
media_bucket_name    = "<globally-unique-private-media-bucket-name>"
media_object_prefix  = "salons"

# Media safety defaults: incomplete uploads are removed quickly, while old
# versions remain recoverable for one year before permanent expiration.
media_multipart_upload_abort_days       = 7
media_noncurrent_version_retention_days = 365

# Existing secret ARNs only; never place secret values in Terraform inputs.
jwt_secret_arn               = "<existing-jwt-secret-arn>"
redis_auth_secret_arn        = "<existing-redis-auth-token-secret-arn>"
auth_hmac_secret_arn         = null
vapid_private_key_secret_arn = null
vapid_public_key              = ""
vapid_subject                 = ""
resend_secret_arn             = null
secret_kms_key_arns   = []
email_from             = "<verified-sender-address-or-empty>"

# Review availability and cost before changing these.
ecs_desired_count       = 2
db_multi_az             = false
redis_num_cache_clusters = 2

tags = {
  Owner = "<team-or-owner>"
}