# Build-time public values only; never put secrets in VITE_* variables.
# Same-origin API requests traverse CloudFront /api/* and preserve tenant Host.
VITE_API_BASE_URL=/
VITE_BASE_DOMAIN=groomit.in
VITE_BASE_PROTOCOL=https
VITE_BASE_PORT=
# Public application-server key for opt-in web push subscriptions.
VITE_VAPID_PUBLIC_KEY=
