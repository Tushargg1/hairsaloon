# Local wildcard-domain development (copy to .env.local).
# Empty API base derives http://<current-host>:8080, preserving tenant Host.
VITE_API_BASE_URL=
VITE_API_PROTOCOL=http
VITE_API_PORT=8080
VITE_BASE_DOMAIN=localhost
VITE_BASE_PROTOCOL=http
VITE_BASE_PORT=5173
# Public VAPID key used only after a signed-in user explicitly enables notifications.
VITE_VAPID_PUBLIC_KEY=
